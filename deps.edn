{:paths ["src/cljel" "src/clj" "resources"]
 :deps {io.github.BuddhiLW/clojure-elisp {:git/tag "v0.4.0" :git/sha "d42b941"}
        ;; hive-addon: the IAddon contract this addon implements. Depending on
        ;; the contract lib rather than on a host namespace is what lets any
        ;; host, hive-mcp or not, mount this jar.
        ;; Floor 0.3.12: first release carrying hive-addon.terminal and
        ;; hive-addon.vessel, the companion contracts this addon reifies.
        io.github.hive-agi/hive-addon {:mvn/version "0.3.12"}
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.20"}
        ;; Floor 0.2.1: hive-claude.init compiles against
        ;; hive-spi.guard.ports/projection-ext-key, which 0.2.0 does not carry.
        io.github.hive-agi/hive-spi {:mvn/version "0.2.1"}
        org.clojure/clojure {:mvn/version "1.12.5"}
        com.taoensso/timbre {:mvn/version "6.8.0"}
        cheshire/cheshire {:mvn/version "6.2.0"}
        ;; SDK dependencies (loaded lazily via requiring-resolve)
        clj-python/libpython-clj {:mvn/version "2.026"}
        org.clojure/core.async {:mvn/version "1.9.865"}
        org.clojure/data.json {:mvn/version "2.5.2"}}
 :aliases
 {:build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.10"}}
          :ns-default hive-build.api}
  :cljel {:extra-deps {io.github.BuddhiLW/clojure-elisp {:git/tag "v0.4.0" :git/sha "d42b941"}}
          :main-opts ["-m" "clojure-elisp.core"]}
  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.3"}}}}}
