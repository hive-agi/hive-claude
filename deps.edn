{:paths ["src/cljel" "src/clj" "resources"]
 :deps {io.github.BuddhiLW/clojure-elisp {:git/tag "v0.4.0" :git/sha "d42b941"}
        io.github.hive-agi/hive-dsl {:git/tag "v0.4.1" :git/sha "07ab02a"}
        org.clojure/clojure {:mvn/version "1.12.0"}
        com.taoensso/timbre {:mvn/version "6.8.0"}
        cheshire/cheshire {:mvn/version "6.2.0"}
        ;; SDK dependencies (loaded lazily via requiring-resolve)
        clj-python/libpython-clj {:mvn/version "2.027"}
        org.clojure/core.async {:mvn/version "1.7.701"}
        org.clojure/data.json {:mvn/version "2.5.1"}}
 :aliases
 {:build {:extra-deps {io.github.BuddhiLW/clojure-elisp {:git/tag "v0.4.0" :git/sha "d42b941"}}
          :main-opts ["-m" "clojure-elisp.core"]}
  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.1"}}}}}
