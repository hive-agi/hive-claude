{:paths ["src/clj" "resources"]
 :deps {;; hive-addon: the IAddon contract this addon implements. Depending on
        ;; the contract lib rather than on a host namespace is what lets any
        ;; host, hive-mcp or not, mount this jar.
        ;; Floor 0.3.12: first release carrying hive-addon.terminal and
        ;; hive-addon.vessel, the companion contracts this addon reifies.
        io.github.hive-agi/hive-addon {:mvn/version "1.1.13"}
        io.github.hive-agi/hive-dsl {:mvn/version "0.6.2"}
        ;; Floor 0.2.1: hive-claude.init compiles against
        ;; hive-spi.guard.ports/projection-ext-key, which 0.2.0 does not carry.
        io.github.hive-agi/hive-spi {:mvn/version "1.4.18"}
        org.clojure/clojure {:mvn/version "1.12.6"}
        com.taoensso/timbre {:mvn/version "6.8.0"}
        cheshire/cheshire {:mvn/version "6.2.0"}
        ;; The Agent-SDK subtree was retired in [SDK-RETIRE-3]: its deps
        ;; (clj-python/libpython-clj, org.clojure/core.async,
        ;; org.clojure/data.json) went with it. cheshire stays: the guard
        ;; projection resolves cheshire.core at runtime.
        }
 :aliases
 {:build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.3.1"}}
          :ns-default hive-build.api}
  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.hive-agi/hive-test {:mvn/version "0.5.2"}
                      ;; Host API tests only; never a production dependency.
                      io.github.hive-agi/hive-mcp {:mvn/version "1.18.0"}}
         :main-opts ["-m" "kaocha.runner"]}}}
